# SnapLink Frontend - Environment Configuration Example
# Copy this file to .env and fill in your values

# Backend API URL
VITE_BACKEND_URL=http://localhost:8089

# Frontend URL (for generating short URL display)
VITE_REACT_FRONT_END_URL=http://localhost:5173

# Backend URL for redirects (where short URLs resolve)
VITE_REACT_SUBDOMAIN=http://localhost:8089

